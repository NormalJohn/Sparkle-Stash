name: E-Hentai增强
desc: https://e-hentai.org
http:
  url-rewrite:
  - ^https:\/\/exhentai\.org https://e-hentai.org 307
  script:
  - name: sparkle.webpage.ehentai.js
    type: response
    match: ^https:\/\/e-hentai\.org\/g\/
    require-body: true
    engine: webkit
  mitm:
  - e-hentai.org
  - exhentai.org
script-providers:
  sparkle.webpage.ehentai.js:
    url: 'https://raw.githubusercontent.com/NormalJohn/Sparkle-Stash/published/versions/92eb00cfc3d30057276e7117292bc0fe1d5a83e2a0207e9af535b52010ecad94/scripts/webpage.ehentai.js'
    interval: 86400
