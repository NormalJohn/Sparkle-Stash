name: Hanime去广告
desc: https://hanime1.me
rules:
- DOMAIN-SUFFIX,jads.co,REJECT,pre-matching
- DOMAIN-SUFFIX,juicyads.com,REJECT,pre-matching
- DOMAIN-SUFFIX,mnaspm.com,REJECT,pre-matching
http:
  script:
  - name: sparkle.webpage.hanime.js
    type: response
    match: ^https:\/\/hanime1\.me\/(?!(favicon|css|js|cdn-cgi|load))
    require-body: true
    engine: webkit
  mitm:
  - hanime1.me
script-providers:
  sparkle.webpage.hanime.js:
    url: 'https://raw.githubusercontent.com/NormalJohn/Sparkle-Stash/published/versions/92eb00cfc3d30057276e7117292bc0fe1d5a83e2a0207e9af535b52010ecad94/scripts/webpage.hanime.js'
    interval: 86400
