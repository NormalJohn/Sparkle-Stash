name: 12306去广告
desc: 移除开屏广告，精简首页
http:
  script:
  - name: sparkle.12306.js
    type: request
    match: ^https:\/\/ad\.12306\.cn\/ad\/ser\/getAdList$
    require-body: true
    engine: webkit
  - name: sparkle.12306.js
    type: request
    match: ^https:\/\/mobile\.12306\.cn\/otsmobile\/app\/mgs\/mgw\.htm$
    require-body: false
    engine: webkit
  mitm:
  - ad.12306.cn
  - mobile.12306.cn
script-providers:
  sparkle.12306.js:
    url: 'https://raw.githubusercontent.com/NormalJohn/Sparkle-Stash/published/versions/3e4a8ae8f4ba16f3ff62df149a6b4c5c3ea11fe8a3b29e3eb30fc2aa4aea2787/scripts/12306.js'
    interval: 86400
