name: E-Hentai增强
desc: https://e-hentai.org
http:
  url-rewrite:
  - ^https:\/\/exhentai\.org https://e-hentai.org 307
  script:
  - name: sparkle.webpage.ehentai.js
    type: response
    match: ^https:\/\/e-hentai\.org\/g\/
    require-body: true
    engine: webkit
  mitm:
  - e-hentai.org
  - exhentai.org
script-providers:
  sparkle.webpage.ehentai.js:
    url: 'https://raw.githubusercontent.com/NormalJohn/Sparkle-Stash/published/versions/3e4a8ae8f4ba16f3ff62df149a6b4c5c3ea11fe8a3b29e3eb30fc2aa4aea2787/scripts/webpage.ehentai.js'
    interval: 86400
