name: MissAV去广告
desc: https://missav.ai
rules:
- DOMAIN,creative.myavlive.com,REJECT,pre-matching
- DOMAIN-SUFFIX,trackwilltrk.com,REJECT,pre-matching
- DOMAIN-SUFFIX,tsyndicate.com,REJECT,pre-matching
http:
  script:
  - name: sparkle.webpage.missav.js
    type: response
    match: ^https:\/\/missav\.ai\/(?!favicon)(?!(build|fonts|img|js|api|cdn-cgi)\/).
    require-body: true
    engine: webkit
  mitm:
  - missav.ai
script-providers:
  sparkle.webpage.missav.js:
    url: 'https://raw.githubusercontent.com/NormalJohn/Sparkle-Stash/published/versions/05265306c6a0e0695bfa24c333cc5d180e70126ef6078e1fb7e2ea88a77352bf/scripts/webpage.missav.js'
    interval: 86400
