name: E-Hentai增强
desc: https://e-hentai.org
http:
  url-rewrite:
  - ^https:\/\/exhentai\.org https://e-hentai.org 307
  script:
  - name: sparkle.webpage.ehentai.js
    type: response
    match: ^https:\/\/e-hentai\.org\/g\/
    require-body: true
    engine: webkit
  mitm:
  - e-hentai.org
  - exhentai.org
script-providers:
  sparkle.webpage.ehentai.js:
    url: 'https://raw.githubusercontent.com/NormalJohn/Sparkle-Stash/published/versions/05265306c6a0e0695bfa24c333cc5d180e70126ef6078e1fb7e2ea88a77352bf/scripts/webpage.ehentai.js'
    interval: 86400
