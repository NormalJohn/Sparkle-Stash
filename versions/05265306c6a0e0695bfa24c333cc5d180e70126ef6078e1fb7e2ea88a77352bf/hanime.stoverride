name: Hanime去广告
desc: https://hanime1.me
rules:
- DOMAIN-SUFFIX,jads.co,REJECT,pre-matching
- DOMAIN-SUFFIX,juicyads.com,REJECT,pre-matching
- DOMAIN-SUFFIX,mnaspm.com,REJECT,pre-matching
http:
  script:
  - name: sparkle.webpage.hanime.js
    type: response
    match: ^https:\/\/hanime1\.me\/(?!(favicon|css|js|cdn-cgi|load))
    require-body: true
    engine: webkit
  mitm:
  - hanime1.me
script-providers:
  sparkle.webpage.hanime.js:
    url: 'https://raw.githubusercontent.com/NormalJohn/Sparkle-Stash/published/versions/05265306c6a0e0695bfa24c333cc5d180e70126ef6078e1fb7e2ea88a77352bf/scripts/webpage.hanime.js'
    interval: 86400
