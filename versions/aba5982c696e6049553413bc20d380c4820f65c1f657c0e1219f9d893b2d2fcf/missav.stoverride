name: MissAV去广告
desc: https://missav.ai
rules:
- DOMAIN,creative.myavlive.com,REJECT,pre-matching
- DOMAIN-SUFFIX,trackwilltrk.com,REJECT,pre-matching
- DOMAIN-SUFFIX,tsyndicate.com,REJECT,pre-matching
http:
  script:
  - name: sparkle.webpage.missav.js
    type: response
    match: ^https:\/\/missav\.ai\/(?!favicon)(?!(build|fonts|img|js|api|cdn-cgi)\/).
    require-body: true
    engine: webkit
  mitm:
  - missav.ai
script-providers:
  sparkle.webpage.missav.js:
    url: 'https://raw.githubusercontent.com/NormalJohn/Sparkle-Stash/published/versions/aba5982c696e6049553413bc20d380c4820f65c1f657c0e1219f9d893b2d2fcf/scripts/webpage.missav.js'
    interval: 86400
