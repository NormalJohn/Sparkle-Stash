name: MissAV去广告
desc: https://missav.ai
rules:
- DOMAIN,creative.myavlive.com,REJECT,pre-matching
- DOMAIN-SUFFIX,trackwilltrk.com,REJECT,pre-matching
- DOMAIN-SUFFIX,tsyndicate.com,REJECT,pre-matching
http:
  script:
  - name: sparkle.webpage.missav.js
    type: response
    match: ^https:\/\/missav\.ai\/(?!favicon)(?!(build|fonts|img|js|api|cdn-cgi)\/).
    require-body: true
    engine: webkit
  mitm:
  - missav.ai
script-providers:
  sparkle.webpage.missav.js:
    url: 'https://raw.githubusercontent.com/NormalJohn/Sparkle-Stash/published/versions/734552c7341b91a6249f9b7fd1946b645d8952e948232cabd97cf870a1b25459/scripts/webpage.missav.js'
    interval: 86400
