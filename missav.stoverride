name: MissAV去广告
desc: https://missav.ai
rules:
- DOMAIN,creative.myavlive.com,REJECT,pre-matching
- DOMAIN-SUFFIX,trackwilltrk.com,REJECT,pre-matching
- DOMAIN-SUFFIX,tsyndicate.com,REJECT,pre-matching
http:
  script:
  - name: sparkle.webpage.missav.js
    type: response
    match: ^https:\/\/missav\.ai\/(?!favicon)(?!(build|fonts|img|js|api|cdn-cgi)\/).
    require-body: true
    engine: webkit
  mitm:
  - missav.ai
script-providers:
  sparkle.webpage.missav.js:
    url: 'https://raw.githubusercontent.com/NormalJohn/Sparkle-Stash/published/versions/92eb00cfc3d30057276e7117292bc0fe1d5a83e2a0207e9af535b52010ecad94/scripts/webpage.missav.js'
    interval: 86400
