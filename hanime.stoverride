name: Hanime去广告
desc: https://hanime1.me
rules:
- DOMAIN-SUFFIX,jads.co,REJECT,pre-matching
- DOMAIN-SUFFIX,juicyads.com,REJECT,pre-matching
- DOMAIN-SUFFIX,mnaspm.com,REJECT,pre-matching
http:
  script:
  - name: sparkle.webpage.hanime.js
    type: response
    match: ^https:\/\/hanime1\.me\/(?!(favicon|css|js|cdn-cgi|load))
    require-body: true
    engine: webkit
  mitm:
  - hanime1.me
script-providers:
  sparkle.webpage.hanime.js:
    url: 'https://raw.githubusercontent.com/NormalJohn/Sparkle-Stash/published/versions/df56806d1f27826230ab502981ebf54b12d463a9c05cff5cc94d80e47113ace9/scripts/webpage.hanime.js'
    interval: 86400
