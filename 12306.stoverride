name: 12306去广告
desc: 移除开屏广告，精简首页
http:
  script:
  - name: sparkle.12306.js
    type: request
    match: ^https:\/\/ad\.12306\.cn\/ad\/ser\/getAdList$
    require-body: true
    engine: webkit
  - name: sparkle.12306.js
    type: request
    match: ^https:\/\/mobile\.12306\.cn\/otsmobile\/app\/mgs\/mgw\.htm$
    require-body: false
    engine: webkit
  mitm:
  - ad.12306.cn
  - mobile.12306.cn
script-providers:
  sparkle.12306.js:
    url: 'https://raw.githubusercontent.com/NormalJohn/Sparkle-Stash/published/versions/df56806d1f27826230ab502981ebf54b12d463a9c05cff5cc94d80e47113ace9/scripts/12306.js'
    interval: 86400
