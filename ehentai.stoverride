name: E-Hentai增强
desc: https://e-hentai.org
http:
  url-rewrite:
  - ^https:\/\/exhentai\.org https://e-hentai.org 307
  script:
  - name: sparkle.webpage.ehentai.js
    type: response
    match: ^https:\/\/e-hentai\.org\/g\/
    require-body: true
    engine: webkit
  mitm:
  - e-hentai.org
  - exhentai.org
script-providers:
  sparkle.webpage.ehentai.js:
    url: 'https://raw.githubusercontent.com/NormalJohn/Sparkle-Stash/published/versions/df56806d1f27826230ab502981ebf54b12d463a9c05cff5cc94d80e47113ace9/scripts/webpage.ehentai.js'
    interval: 86400
