name: E-Hentai增强
desc: https://e-hentai.org
http:
  url-rewrite:
  - ^https:\/\/exhentai\.org https://e-hentai.org 307
  script:
  - name: sparkle.webpage.ehentai.js
    type: response
    match: ^https:\/\/e-hentai\.org\/g\/
    require-body: true
    engine: webkit
  mitm:
  - e-hentai.org
  - exhentai.org
script-providers:
  sparkle.webpage.ehentai.js:
    url: 'https://raw.githubusercontent.com/NormalJohn/Sparkle-Stash/published/versions/0011e296e64ea94f0eac3dd9a4ee2b59662e13dee587695e623165757182baa5/scripts/webpage.ehentai.js'
    interval: 86400
